{
  "name": "@oatelauser/crosschat",
  "version": "1.13.1",
  "type": "module",
  "description": "Let Claude Code and Codex CLI talk to each other on your machine: native delivery via named pipe and app-server, stateless CLI, no daemon.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oatelauser/crosschat.git"
  },
  "license": "MIT",
  "bin": {
    "crosschat": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --dir test",
    "lint": "eslint src test",
    "check:imports": "node scripts/runtime-import-graph.mjs",
    "check": "npm run lint && npm run check:imports && npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.7.0",
    "@types/react": "19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.1",
    "ink-testing-library": "4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "ink": "8.0.0",
    "react": "19.3.1",
    "string-width": "8.3.0",
    "ws": "^8.22.0"
  }
}
